# Copy these variables into Railway project variables (or .env in local dev)
# Values must match the keys referenced in includes/config.php

# Website
SITE_NAME=SLB BC KARYA SEJAHTERA
# Use / for root deployment on Railway or other hosted root domain
BASE_URL=/ 

# Supabase
SUPABASE_URL=
# Alternatively, Railway may suggest NEXT_PUBLIC_SUPABASE_URL
# If so, you can use the suggested name or this one.
SUPABASE_KEY=
# Alternatively, Railway may suggest NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Admin credentials (set secure values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=
